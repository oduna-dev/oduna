# Bootstrap pre-seed: the single human source for every credential the
# pipeline needs. Copy this file to `.bootstrap-secrets.env` (gitignored,
# workstation-local) and fill it in; after a successful run the contents are
# archived into the offline recovery vault and the filled file is deleted — the
# vault then holds everything the next install needs.
#
# The pipeline scripts refuse to run while any required value is empty.

# Registrar credentials used by Caddy's INWX DNS-01 challenges for all TLS
# certificates. INWX rejects API logins from accounts with 2FA — create a
# dedicated API sub-user with rights on the zone.
INWX_USERNAME=
INWX_PASSWORD=

# mailbox.org app password of the smtp.user relay account; consumed by the
# Forgejo, Vaultwarden and Actual Budget mail senders.
SMTP_PASSWORD=

# NetBird dashboard personal API token with rights to create setup keys (an
# access token, not a setup key; read-write scope). EU-instance accounts need
# their regional API base, uncomment the URL line for them:
# NETBIRD_API_URL=https://api.eu.netbird.io
NETBIRD_API_TOKEN=

# Healthchecks.io project API key (read-write): the pipeline re-creates and
# resolves the dead-man's checks with it.
HEALTHCHECKS_API_KEY=

# Hetzner StorageBox account (main or sub-account): receives the Borg
# append-only SSH key and hosts the backup repo path.
STORAGEBOX_USERNAME=
STORAGEBOX_PASSWORD=

# Shared break-glass admin across the user-facing services (Forgejo, Beszel,
# Vaultwarden, Immich, Actual Budget, Navidrome): homelab-converge creates
# missing accounts with it and converges existing ones to it on every
# activation — rotating this pair converges every app at the next rebuild.
# The email local part becomes the Forgejo username and must avoid Forgejo's
# reserved names (admin, root, ...).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Authentik break-glass admin (akadmin) initial password. Optional: left
# empty, the pipeline generates one instead and the escrow/encrypted secrets
# file stays the record for it.
AUTHENTIK_BOOTSTRAP_PASSWORD=

# Optional: pin the Borg repo passphrase across reinstalls so the existing
# append-only StorageBox repo (and its snapshot history) stays usable.
# Leave empty for a per-install passphrase (that offsite repo must then be
# re-created instead of re-joined).
BORG_PASSPHRASE=
